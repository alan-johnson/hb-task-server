<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.handsbreadth.hb-task-server</string>

  <key>ProgramArguments</key>
  <array>
    <!-- EDIT THIS: replace YOUR_USERNAME with your Mac username (run `whoami` in Terminal) -->
    <!-- EDIT THIS: replace hb-task-server with the folder name where you unzipped the server -->
    <string>/Users/YOUR_USERNAME/hb-task-server/hb-task-server-arm64</string>
  </array>

  <!-- EDIT THIS: must be the same folder as ProgramArguments above -->
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/hb-task-server</string>

  <!-- Start automatically on login -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Restart automatically if the server crashes -->
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/hb-task-server.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/hb-task-server.log</string>
</dict>
</plist>
