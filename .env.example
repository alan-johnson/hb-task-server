# Server Configuration
PORT=3000

# Default task provider (apple, reminders-cli)
DEFAULT_PROVIDER=apple

# ── UpQ Bridge (optional) ────────────────────────────────────────────────────
# Connect this server to the UpQ cloud server so it can reach Apple Reminders.
# 1. Log in to UpQ and call POST /auth/bridge/key to generate an API key.
# 2. Set BRIDGE_URL to the UpQ server's WebSocket bridge endpoint.
# 3. Set BRIDGE_API_KEY to the key returned in step 1.
# Leave both commented out to run in standalone mode (no cloud connection).
# BRIDGE_URL=ws://your-upq-domain.com/bridge
# BRIDGE_API_KEY=your-64-character-hex-key-from-upq

# ── Logging ──────────────────────────────────────────────────────────────────
# Logs are written to logs/hb-task-server-YYYY-MM-DD.log, rotating daily.
# Rotated files older than this many days are deleted automatically.
# Set to 0 to keep every log file forever (no automatic cleanup).
LOG_RETENTION_DAYS=14
